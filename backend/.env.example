PORT=8000
NODE_ENV=production
VERSION=1.0.0

# Observability (OpenTelemetry + Pino)
ENABLE_OTEL=false
OTEL_DEBUG=false
OTEL_TRACE_SAMPLE_RATE=1.0
OTLP_TRACE_ENDPOINT=http://localhost:4318/v1/traces
OTLP_TIMEOUT_MS=5000
OTLP_HEADERS=
DD_API_KEY=
SERVICE_NAME=trip-planner-api
LOG_LEVEL=info
PRETTY_LOGS=false

# Performance Thresholds
SLOW_QUERY_THRESHOLD=100
SLOW_REQUEST_THRESHOLD_MS=1000
SLOW_CONNECTION_ACQUIRE_MS=100
LARGE_PAYLOAD_THRESHOLD_BYTES=1048576

# Database Pool Configuration
DB_POOL_MAX=25
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=60000
DB_POOL_IDLE_MS=10000
DB_POOL_EVICT_MS=1000
DB_CONNECT_RETRIES=5
DB_RETRY_DELAY_MS=5000

# Monitoring
POOL_MONITOR_INTERVAL_MS=30000

# Database Sync — creates missing tables on boot; set false when using migrations
ENABLE_SYNC=true

# PostgreSQL (Render / Supabase / Railway)
DATABASE_URL=postgresql://user:password@host/dbname
DB_SSL=true

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=1d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-frontend.onrender.com,http://localhost:4173

# Backend URL (used for OAuth callback)
BACKEND_URL=https://your-backend.onrender.com

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Trip Planner

# Password Reset
RESET_TOKEN_TTL_MIN=15